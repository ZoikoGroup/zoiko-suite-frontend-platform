# ZoikoSuite backend connection
#
# Copy to .env.local for local development. These are server-only — deliberately
# NOT prefixed NEXT_PUBLIC_, because all backend calls are made from Server
# Components and must never reach the browser.
#
# Start the services you need from the backend repo:
#   cd zoiko-suite/zoiko-suite
#   docker compose -f deployments/docker-compose.yml up -d

# --- Direct-to-service (default for local dev) -------------------------------
# Each backend service publishes its own port locally.

# Tax Governance Domain (ports 8125–8130, 8147)
ZOIKO_TAX_RULES_URL=http://localhost:8125
ZOIKO_TAX_DETERMINATION_URL=http://localhost:8126
ZOIKO_VAT_GST_URL=http://localhost:8127
ZOIKO_CORPORATE_TAX_URL=http://localhost:8128
ZOIKO_WITHHOLDING_TAX_URL=http://localhost:8129
ZOIKO_FILING_PREPARATION_URL=http://localhost:8130
ZOIKO_TAX_AUTHORITY_URL=http://localhost:8147

# Legal Governance Domain (ports 8119–8124)
ZOIKO_CONTRACT_LIFECYCLE_URL=http://localhost:8119
ZOIKO_CLAUSE_TEMPLATE_URL=http://localhost:8120
ZOIKO_OBLIGATION_TRACKING_URL=http://localhost:8121
ZOIKO_BOARD_RESOLUTIONS_URL=http://localhost:8122
ZOIKO_CORPORATE_ACTIONS_URL=http://localhost:8123
ZOIKO_COUNTERPARTY_URL=http://localhost:8124

# Finance Governance Domain (ports 8098–8108)
ZOIKO_GENERAL_LEDGER_URL=http://localhost:8098
ZOIKO_ACCOUNTS_PAYABLE_URL=http://localhost:8099
ZOIKO_ACCOUNTS_RECEIVABLE_URL=http://localhost:8101
ZOIKO_BANK_RECONCILIATION_URL=http://localhost:8102
ZOIKO_TREASURY_URL=http://localhost:8103
ZOIKO_FINANCIAL_CLOSE_URL=http://localhost:8104
ZOIKO_INTERCOMPANY_URL=http://localhost:8105
ZOIKO_CONSOLIDATION_URL=http://localhost:8106

# HR Domain (ports 8108–8109, 8115–8118)
ZOIKO_EMPLOYEE_MASTER_URL=http://localhost:8108
ZOIKO_EMPLOYMENT_CONTRACTS_URL=http://localhost:8109
ZOIKO_LEAVE_ABSENCE_URL=http://localhost:8115
ZOIKO_ORG_STRUCTURE_URL=http://localhost:8116
ZOIKO_OFFBOARDING_URL=http://localhost:8117
ZOIKO_WORKFORCE_COMPLIANCE_URL=http://localhost:8118

# Payroll Domain (ports 8110–8114)
ZOIKO_PAYROLL_RUN_URL=http://localhost:8110
ZOIKO_COMPENSATION_URL=http://localhost:8111
ZOIKO_BENEFITS_URL=http://localhost:8112
ZOIKO_PAYROLL_TAX_URL=http://localhost:8113
ZOIKO_PAYROLL_EXCEPTIONS_URL=http://localhost:8114

# Commercial Ops Domain (ports 8100, 8107, 8112, 8131, 8134, 8135)
ZOIKO_PURCHASE_REQUEST_URL=http://localhost:8100
ZOIKO_PURCHASE_ORDER_URL=http://localhost:8112
ZOIKO_INVOICE_APPROVAL_URL=http://localhost:8107
ZOIKO_SPEND_CONTROLS_URL=http://localhost:8131
ZOIKO_VENDOR_DUE_DILIGENCE_URL=http://localhost:8135
ZOIKO_INVOICE_MATCH_URL=http://localhost:8134

# Compliance Domain (ports 8088, 8095, 8130)
ZOIKO_OBLIGATIONS_URL=http://localhost:8088
ZOIKO_EVIDENCE_MANIFEST_URL=http://localhost:8095
ZOIKO_GOVERNANCE_URL=http://localhost:8083
ZOIKO_CONFIGURATION_URL=http://localhost:8086

# Audit Events Domain (port 8084)
ZOIKO_AUDIT_EVENT_STORE_URL=http://localhost:8084

# --- Via the Traefik gateway (single port, and how production works) --------
# One port fronts every service; each is reached at /<service-name>/<path>.
# In a real deployment the per-service ports are NOT published at all.
#
# The port is GATEWAY_PORT in the backend compose (default 8000, because :80 is
# usually taken on a dev machine). Prefixes come from the generated
# deployments/traefik-dynamic/all-services.yml and are the full service names.
ZOIKO_USE_GATEWAY=true
ZOIKO_GATEWAY_URL=http://localhost:8000

# Per-request timeout in ms. A panel whose service exceeds this degrades to an
# empty state rather than blocking the dashboard render.
ZOIKO_API_TIMEOUT_MS=5000
