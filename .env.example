# ZoikoSuite backend connection
#
# Copy to .env.local for local development. These are server-only — deliberately
# NOT prefixed NEXT_PUBLIC_, because all backend calls are made from Server
# Components and must never reach the browser.
#
# Start the services you need from the backend repo:
#   cd zoiko-suite/zoiko-suite
#   docker compose -f deployments/docker-compose.yml up -d governance-svc obligations-svc \
#     contract-lifecycle-svc

# --- Direct-to-service (default for local dev) -------------------------------
# Each backend service publishes its own port locally.
ZOIKO_GOVERNANCE_URL=http://localhost:8083
ZOIKO_POLICY_URL=http://localhost:8085
ZOIKO_CONFIGURATION_URL=http://localhost:8086
ZOIKO_SECRET_VAULT_URL=http://localhost:8087
ZOIKO_OBLIGATIONS_URL=http://localhost:8088
ZOIKO_CONTRACTS_URL=http://localhost:8119
ZOIKO_PURCHASE_ORDER_URL=http://localhost:8129
ZOIKO_EVIDENCE_URL=http://localhost:8130

# --- Via the Traefik gateway (single port, and how production works) --------
# One port fronts every service; each is reached at /<service-name>/<path>.
# In a real deployment the per-service ports are NOT published at all.
#
# The port is GATEWAY_PORT in the backend compose (default 8000, because :80 is
# usually taken on a dev machine). Prefixes come from the generated
# deployments/traefik-dynamic/all-services.yml and are the full service names.
ZOIKO_USE_GATEWAY=true
ZOIKO_GATEWAY_URL=http://localhost:8000

# Per-request timeout in ms. A panel whose service exceeds this degrades to an
# empty state rather than blocking the dashboard render.
ZOIKO_API_TIMEOUT_MS=5000
